{
  "id": "./",
  "name": "المكتبة الإسلامية — نور الهدى وبوابة النور",
  "short_name": "المكتبة",
  "description": "مصحف، أذكار، مواقيت صلاة، زكاة، دروس فقهية على منهج سلف الأمة، وأدوات إسلامية — يعمل بدون إنترنت.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#F6EFDF",
  "theme_color": "#0b3d2c",
  "categories": ["education", "lifestyle", "books", "utilities"],
  "prefer_related_applications": false,
  "periodicsync": { "min_interval": "2h" },
  "icons": [
    { "src": "./icons/favicon-16.png", "sizes": "16x16", "type": "image/png" },
    { "src": "./icons/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "المصحف", "short_name": "المصحف", "url": "./src/app/app.html#tab/quran", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "الأذكار", "short_name": "أذكار", "url": "./src/app/app.html#tab/athkar", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "مواقيت الصلاة", "short_name": "المواقيت", "url": "./src/app/app.html#tab/prayer", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "السبحة", "short_name": "السبحة", "url": "./src/app/app.html#tab/athkar", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "موقع نور الهدى", "short_name": "نور الهدى", "url": "./src/site/noor.html", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}