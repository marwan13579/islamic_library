{"no":79,"name":"النازعات","verses":46,"place":"مكية","count":37,"entries":[{"a":1,"w":"وَالنَّازِعَاتِ","m":"قَسَمٌ بِالمَلَائِكَةِ تَنْزِعُ أَرْوَاحَ الكُفَّارِ.","o":[]},{"a":1,"w":"غَرْقًا","m":"نَزْعًا شَدِيدًا.","o":[]},{"a":2,"w":"وَالنَّاشِطَاتِ","m":"قَسَمٌ بِالمَلَائِكَةِ تَسُلُّ أَرْوَاحَ المُؤْمِنِينَ بِرِفْقٍ.","o":[]},{"a":3,"w":"وَالسَّابِحَاتِ","m":"قَسَمٌ بِالمَلَائِكَةِ الَّتِي تَسْبَحُ فِي نُزُولِهَا مِنَ السَّمَاءِ، وَصُعُودِها إِلَيْهَا.","o":[]},{"a":4,"w":"فَالسَّابِقَاتِ","m":"قَسَمٌ بِالمَلَائِكَةِ الَّتِي تَسْبِقُ الشَّيَاطِينَ بِالوَحْيِ إِلَى الأَنْبِيَاء؛ لِئَلَّا تَسْتَرِقَهُ.","o":[]},{"a":5,"w":"فَالْمُدَبِّرَاتِ أَمْرًا","m":"قَسَمٌ بِالمَلَائِكَةِ المُنَفِّذَاتِ أَمْرَ اللهِ، وَجَوابُ القَسَمِ مَحْذُوفٌ، لَتُبْعَثُنَّ.","o":[[18,105],[27,38],[43,81],[51,3]]},{"a":6,"w":"تَرْجُفُ الرَّاجِفَةُ","m":"نَفْخَةِ الصَّعْقِ.","o":[[73,14]]},{"a":7,"w":"تَتْبَعُهَا الرَّادِفَةُ","m":"تَلِيهَا نَفْخَةٌ أُخْرَى لِلْبَعْثِ.","o":[]},{"a":8,"w":"وَاجِفَةٌ","m":"خَائِفَةٌ، مُضْطَرِبَةٌ.","o":[]},{"a":9,"w":"خَاشِعَةٌ","m":"ذَلِيلَةٌ مِنْ هَوْلِ مَا تُشَاهِدُ.","o":[[41,48],[68,38],[70,35],[88,1]]},{"a":10,"w":"الْحَافِرَةِ","m":"الحَالَةِ الَّتِي كُنَّا عَلَيْهَا فَي الأَرْضِ.","o":[]},{"a":11,"w":"نَّخِرَةً","m":"بَالِيَةً.","o":[]},{"a":13,"w":"كَرَّةٌ خَاسِرَةٌ","m":"رَجْعَةٌ خَائِبَةٌ ذَاتُ خُسْرَانٍ.","o":[[26,34],[39,71]]},{"a":13,"w":"زَجْرَةٌ","m":"نَفْخَةٌ.","o":[[37,13]]},{"a":14,"w":"بِالسَّاهِرَةِ","m":"بِوَجْهِ الأَرْضِ أَحْيَاءً بَعْدَ أَنْ كَانُوا فِي بَطْنِهَا.","o":[]},{"a":16,"w":"الْمُقَدَّسِ","m":"المُطَهَّرِ.","o":[[20,5]]},{"a":16,"w":"طُوًى","m":"اسْمُ الوَادِي.","o":[]},{"a":18,"w":"تَزَكَّى","m":"تَتَطَهَّرَ مِنَ الكُفْرِ، وَتَتَحَلَّى بِالإِيمَانِ.","o":[[35,34],[87,11],[87,12]]},{"a":19,"w":"وَأَهْدِيَكَ","m":"أُرْشِدَكَ.","o":[]},{"a":20,"w":"الْآيَةَ الْكُبْرَى","m":"مُعْجِزَةَ العَصَا، وَاليَدَ البَيْضَاءَ.","o":[[44,9]]},{"a":22,"w":"يَسْعَى","m":"يَجْتَهِدُ فِي مُعَارَضَةِ مُوسَى - عليه السلام -.","o":[[36,14],[66,12]]},{"a":23,"w":"فَحَشَرَ","m":"جَمَعَ أَهْلَ مَمْلَكَتِهِ.","o":[]},{"a":25,"w":"نَكَالَ","m":"عُقُوبَةَ.","o":[]},{"a":28,"w":"رَفَعَ سَمْكَهَا","m":"أَعْلَى سَقْفَهَا.","o":[]},{"a":29,"w":"وَأَغْطَشَ لَيْلَهَا","m":"أَظْلَمَ لَيْلَهَا بِغُرُوبِ شَمْسِهَا.","o":[]},{"a":29,"w":"وَأَخْرَجَ ضُحَاهَا","m":"أَبْرَزَ نَهَارَهَا بِشُرُوقِ شَمْسِهَا.","o":[[79,36]]},{"a":30,"w":"دَحَاهَا","m":"بَسَطَهَا، وَأَوْدَعَ فِيهَا مَنَافِعَهَا.","o":[]},{"a":31,"w":"وَمَرْعَاهَا","m":"مَا يُرْعَى مِنَ النَّبَاتِ.","o":[]},{"a":32,"w":"أَرْسَاهَا","m":"أَثْبَتَهَا عَلَى الأَرْضِ؛ كَالْأَوْتَادِ.","o":[]},{"a":34,"w":"الطَّامَّةُ","m":"القِيَامَةُ، وَهِيَ النَّفْخَةُ الثَّانِيَةُ.","o":[]},{"a":36,"w":"وَبُرِّزَتِ","m":"أُظْهِرَتْ إِظْهَارًا بَيِّنًا.","o":[[26,31]]},{"a":39,"w":"الْمَاوَى","m":"المَصِيرُ.","o":[[32,14]]},{"a":40,"w":"مَقَامَ رَبِّهِ","m":"القِيَامَ بَيْنَ يَدَيْ رَبِّهِ لِلْحِسَابِ.","o":[[3,52],[33,23],[44,36],[55,43],[12,29],[68,50]]},{"a":42,"w":"أَيَّانَ مُرْسَاهَا","m":"مَتَى وَقْتُ حُلُولِهَا؟","o":[[7,188],[16,15],[27,79],[51,12],[75,3]]},{"a":43,"w":"فِيمَ أَنتَ مِن ذِكْرَاهَا","m":"لَيْسَ عِنْدَكَ عِلْمُهَا؛ حَتَّى تَذْكُرَهَا.","o":[[34,68],[37,74],[44,34],[2,139],[2,149],[4,18],[7,25],[7,205],[8,56],[11,100],[11,102],[11,141],[12,35],[12,111],[13,12],[13,32],[13,37],[15,56],[17,86],[17,130],[18,3],[18,102],[20,43],[20,66],[20,79],[20,84],[21,22],[21,23],[21,33],[21,41],[21,76],[22,14],[22,31],[22,50],[22,75],[23,6],[23,24],[23,48],[24,30],[24,58],[26,12],[27,2],[27,12],[27,14],[27,53],[28,13],[28,40],[28,42],[29,49],[30,12],[30,46],[30,50],[30,51],[31,13],[31,15],[32,13],[32,18],[32,21],[33,46],[34,5],[37,24],[37,93],[38,90],[39,8],[39,21],[39,39],[40,98],[41,29],[41,56],[41,62],[41,71],[41,78],[42,60],[42,61],[42,69],[45,10],[45,12],[46,6],[47,21],[49,20],[49,25],[50,36],[51,43],[52,35],[55,15],[56,20],[56,77],[60,28],[65,14],[65,15],[66,20],[67,15],[67,24],[68,50],[75,21],[87,12],[98,2],[111,8],[114,5]]},{"a":46,"w":"عَشِيَّةً","m":"مَا بَيْنَ الظُ