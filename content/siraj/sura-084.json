{"no":84,"name":"الانشقاق","verses":25,"place":"مكية","count":17,"entries":[{"a":1,"w":"انشَقَّتْ","m":"تَصَدَّعَتْ، وَتَفَطَّرَتْ بِالغَمَامِ يَوْمَ القِيَامَةِ.","o":[]},{"a":2,"w":"وَأَذِنَتْ لِرَبِّهَا","m":"أَطَاعَتْ لِأَمْرِ رَبِّهَا.","o":[]},{"a":2,"w":"وَحُقَّتْ","m":"وَحُقَّ لَهَا أَنْ تُطِيعَ.","o":[]},{"a":3,"w":"مُدَّتْ","m":"بُسِطَتْ، وَوُسِّعَتْ، وَدُكَّتْ جِبَالُهَا.","o":[]},{"a":4,"w":"وَأَلْقَتْ","m":"قَذَفَتْ مَا فِي بَطْنِهَا مِنَ الأَمْوَاتِ.","o":[]},{"a":6,"w":"كَادِحٌ إِلَى رَبِّكَ","m":"سَاعٍ إِلَى اللهِ، وَعَامِلٌ بِالخَيْرِ أَوِ الشَّرِّ.","o":[[7,176],[8,15],[10,51],[22,21],[28,110],[37,51],[37,80],[44,11],[61,10],[66,5],[12,48],[16,115],[23,55],[40,70],[43,35],[43,37],[50,51],[52,23],[52,31],[52,45],[53,39],[56,63],[69,50],[74,25],[76,36],[87,0],[89,21],[99,5],[110,2]]},{"a":7,"w":"كِتَابَهُ","m":"صَحِيفَةَ عَمَلِهِ.","o":[]},{"a":11,"w":"يَدْعُو ثُبُورًا","m":"وَاثُبُورَاهْ!","o":[[25,13]]},{"a":12,"w":"وَيَصْلَى سَعِيرًا","m":"يَدْخُلُ النَّارَ يُقَاسِي حَرَّهَا.","o":[[25,10],[33,122]]},{"a":14,"w":"لَّن يَحُورَ","m":"لَنْ يَرْجِعَ إِلَى اللهِ لِيُحَاسِبَهُ.","o":[[9,95],[20,73],[21,70],[35,41],[45,13],[48,14],[72,19],[73,23]]},{"a":16,"w":"فَلَا أُقْسِمُ","m":"أُقْسِمُ، وَ : لِتَاكِيدِ القَسَمِ.","o":[[56,64],[69,44],[70,30],[81,15],[5,49],[7,129],[11,22],[11,40],[11,135],[12,74],[18,30],[21,80],[28,28],[28,48],[31,39],[33,57],[34,78],[35,3],[35,6],[36,26],[40,2],[43,67],[47,55],[53,26],[55,36],[90,9],[93,7],[93,9],[75,0],[90,0]]},{"a":16,"w":"بِالشَّفَقِ","m":"بِاحْمِرَارِ الأُفُقِ عِنْدَ الغُرُوبِ.","o":[]},{"a":17,"w":"وَسَقَ","m":"جَمَعَ.","o":[]},{"a":18,"w":"اتَّسَقَ","m":"تَكَامَلَ نُورُهُ، وَأَبْدَرَ.","o":[]},{"a":19,"w":"طَبَقًا عَن طَبَقٍ","m":"أَطْوَارًا مُتَعَدِّدَةً، نُطْفَةً، ثُمَ عَلَقَةً، وَهَكَذَا.","o":[[9,121],[11,57],[28,9],[37,18],[68,37]]},{"a":23,"w":"يُوعُونَ","m":"يَكْتُمُونَ فيِ صُدُورِهِمْ مِنَ العِنَادِ، وَالتَّكْذِيبِ.","o":[]},{"a":25,"w":"غَيْرُ مَمْنُونٍ","m":"غَيْرُ مَقْطُوعٍ، وَلَا مَنْقُوصٍ.","o":