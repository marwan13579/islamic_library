{"no":73,"name":"المزمل","verses":20,"place":"مكية","count":29,"entries":[{"a":1,"w":"الْمُزَّمِّلُ","m":"المُتَزَمِّلُ، المُتَلَفِّفُ بِثِيَابِهِ.","o":[]},{"a":4,"w":"وَرَتِّلِ","m":"اقْرَا بِتُؤَدَةٍ وَتَمَهَّلٍ؛ مُبَيِّنًا الحُرُوفَ وَالوُقُوفَ.","o":[]},{"a":5,"w":"ثَقِيلًا","m":"عَظِيمًا، مُشْتَمِلًا عَلَى الأَوَامِرِ وَالنَّوَاهِي.","o":[]},{"a":6,"w":"نَاشِئَةَ اللَّيْلِ","m":"العِبَادَةَ الَّتِي تَنْشَأُ فِي جَوْفِ اللَّيْلِ بَعْدَ النَّوْمِ.","o":[[11,102],[11,141],[17,101],[34,56],[39,17]]},{"a":6,"w":"هِيَ أَشَدُّ وَطْئًا","m":"أَشَدُّ تَاثِيرًا فِي القَلْبِ.","o":[]},{"a":6,"w":"وَأَقْوَمُ قِيلًا","m":"أَبْيَنُ قَوْلًا؛ لِحُضُورِ القَلْبِ، وَقِلَّةِ الشَّوَاغِلِ.","o":[[2,228],[4,60],[4,114],[56,27]]},{"a":7,"w":"سَبْحًا","m":"تَصّرُّفًا، وَتَقَلُّبًا فِي مَصَالِحِكَ.","o":[]},{"a":8,"w":"وَتَبَتَّلْ","m":"انْقَطِعْ لِعِبَادَتِهِ.","o":[]},{"a":9,"w":"وَكِيلًا","m":"تُفَوِّضُ أُمُورَكَ إِلَيْهِ، وَتَعْتَمِدُ عَلَيْهِ.","o":[[17,1],[17,85],[33,0]]},{"a":10,"w":"هَجْرًا جَمِيلًا","m":"أَعْرِضْ عَنْهُمْ؛ تَارِكًا الاِنْتِقَامَ مْنْهُمْ.","o":[[33,51],[33,87],[70,5]]},{"a":11,"w":"أُولِي النَّعْمَةِ","m":"أَصْحَابَ النَّعِيمِ وَالتَّرَفِ.","o":[[17,3],[24,28],[33,7],[35,1],[38,75],[48,20],[59,6],[75,27]]},{"a":11,"w":"وَمَهِّلْهُمْ قَلِيلًا","m":"أَجِّلْهُمْ زَمَنًا قَلِيلًا بِتَاخِيرِ العَذَابِ عَنْهُمْ.","o":[]},{"a":12,"w":"أَنكَالًا","m":"قُيُودًا ثَقِيلَةً.","o":[]},{"a":13,"w":"ذَا غُصَّةٍ","m":"يَنْشَبُ فِي الحُلُوقِ، لَا يُسْتَسَاغُ؛ لِكَرَاهَتِهِ.","o":[[38,21],[90,13],[90,14]]},{"a":14,"w":"تَرْجُفُ","m":"تَضْطَرِبُ.","o":[[79,6]]},{"a":14,"w":"كَثِيبًا","m":"رَمْلًا مُجْتَمِعًا.","o":[]},{"a":14,"w":"مَّهِيلًا","m":"سَائِلًا مُتَنَاثِرًا.","o":[]},{"a":16,"w":"وَبِيلًا","m":"شَدِيدًا.","o":[]},{"a":18,"w":"مُنفَطِرٌ بِهِ","m":"مُتَصَدِّعَةٌ فِي يَوْمِ القِيَامَةِ.","o":[[2,103],[4,82],[5,12],[6,118],[7,194],[12,27],[16,106],[18,33],[18,103],[20,17],[20,72],[22,29],[23,51],[25,39],[28,7],[51,47],[52,26],[58,12],[75,10],[100,5]]},{"a":18,"w":"مَفْع