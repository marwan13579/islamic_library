{"no":81,"name":"التكوير","verses":29,"place":"مكية","count":30,"entries":[{"a":1,"w":"كُوِّرَتْ","m":"لُفَّتْ، وَذَهَبَ ضَوْؤُهَا.","o":[]},{"a":2,"w":"انكَدَرَتْ","m":"تَنَاثَرَتْ، وَذَهَبَ نُورُهَا.","o":[]},{"a":3,"w":"سُيِّرَتْ","m":"أُزِيلَتْ عَنْ وَجْهِ الأَرْضِ؛ فَصَارَتْ هَبَاءً مَنْثُورًا.","o":[]},{"a":4,"w":"الْعِشَارُ","m":"النُّوقُ الحَوَامِلُ.","o":[]},{"a":4,"w":"عُطِّلَتْ","m":"أُهْمِلَتْ، وَتُرِكَتْ.","o":[]},{"a":5,"w":"حُشِرَتْ","m":"جُمِعَتْ، وَاخْتَلَطَتْ؛ لِيُقْتَصَّ لِبَعْضِهَا مِنْ بَعْضٍ.","o":[]},{"a":6,"w":"سُجِّرَتْ","m":"مُلِئَتْ حَتَّى خَاضَتْ، فَانْفَجَرَت، ثُمَّ اتَّقَدَتْ نِيرَانًا.","o":[]},{"a":7,"w":"زُوِّجَتْ","m":"قُرِنَتْ بِأَمْثَالِهَا وَنَظَائِرِهَا.","o":[]},{"a":8,"w":"الْمَوْؤُودَةُ","m":"الطِّفْلَةُ المَدْفُونَةُ حَيَّةً.","o":[]},{"a":10,"w":"الصُّحُفُ","m":"صُحُفُ الأَعْمَالِ.","o":[]},{"a":10,"w":"نُشِرَتْ","m":"فُتِحَتْ، وَبُسِطَتْ.","o":[]},{"a":11,"w":"كُشِطَتْ","m":"قُلِعَتْ، وَأُزِيلَتْ.","o":[]},{"a":12,"w":"سُعِّرَتْ","m":"أُوقِدَتْ، فَأُضْرِمَتْ.","o":[]},{"a":13,"w":"أُزْلِفَتْ","m":"قُرِّبَتْ مِنْ أَهْلِهَا.","o":[]},{"a":14,"w":"أَحْضَرَتْ","m":"قَدَّمَتْ مِنْ خَيْرٍ أَوْ شَرٍّ.","o":[]},{"a":15,"w":"فَلَا أُقْسِمُ","m":"أُقْسِمُ، وَ : لِتَاكِيدِ الْقَسَمِ.","o":[[56,64],[69,44],[70,30],[84,10],[5,49],[7,129],[11,22],[11,40],[11,135],[12,74],[18,30],[21,80],[28,28],[28,48],[31,39],[33,57],[34,78],[35,3],[35,6],[36,26],[40,2],[43,67],[47,55],[53,26],[55,36],[90,9],[93,7],[93,9],[75,0],[90,0]]},{"a":15,"w":"بِالْخُنَّسِ","m":"النُّجُومِ المُخْتَفِيَةِ أَنْوَارُهَا نَهَارًا.","o":[]},{"a":16,"w":"الْجَوَارِ","m":"النُّجُومِ الجَارِيَةِ فيِ أَفْلَاكِهَا.","o":[[42,42],[55,23]]},{"a":16,"w":"الْكُنَّسِ","m":"النُّجُومِ المُسْتَتِرَةِ فِي أَبْرَاجِهِا.","o":[]},{"a":17,"w":"عَسْعَسَ","m":"أَقْبَلَ بِظَلَامِهِ، وَأَدْبَرَ.","o":[]},{"a":18,"w":"تَنَفَّسَ","m":"ظَهَرَ ضِيَاؤْهُ، وَامْتَدَّ.","o":[]},{"a":19,"w":"رَسُولٍ كَرِيمٍ","m":"جِبْرِيلُ - عليه السلام -.","o":[[44,6],[98,2],[26,2],[26,18],[27,35],[31,6],[44,1