{"no":91,"name":"الشمس","verses":15,"place":"مكية","count":19,"entries":[{"a":1,"w":"وَضُحَاهَا","m":"قَسَمٌ بِإِشِرَاقِ الشَّمْسِ ضُحًى.","o":[]},{"a":2,"w":"تَلَاهَا","m":"تَبِعَ الشَّمْسَ فيِ الطُّلُوعِ وَالأُفُولِ.","o":[]},{"a":3,"w":"جَلَّاهَا","m":"كَشَفَ ظْلْمَةَ اللَّيْلِ وَأَزَالَهَا.","o":[]},{"a":4,"w":"يَغْشَاهَا","m":"يُغَطِّي الأَرْضَ بِظُلْمَتِهِ.","o":[]},{"a":6,"w":"طَحَاهَا","m":"بَسَطَهَا.","o":[]},{"a":7,"w":"سَوَّاهَا","m":"أَكْمَلَ خَلْقَهَا؛ لِأَدَاءِ مُهِمَّتِهَا.","o":[]},{"a":8,"w":"فَأَلْهَمَهَا","m":"بَيَّنَ لَهَا.","o":[]},{"a":8,"w":"فُجُورَهَا وَتَقْوَاهَا","m":"طَرِيقَ الخَيْرِ، وَطَرِيقَ الشَّرِّ.","o":[]},{"a":9,"w":"زَكَّاهَا","m":"طَهَّرَهَا وَنَمَّاهَا بِالطَّاعَةِ.","o":[]},{"a":10,"w":"خَابَ","m":"خَسِرَ.","o":[]},{"a":10,"w":"دَسَّاهَا","m":"أَخْفَى نَفْسَهُ، وَنَقَصَهَا بِالمَعَاصِي.","o":[]},{"a":11,"w":"بِطَغْوَاهَا","m":"بِسَبَبِ طُغْيَانِهَا، وَتَجَاوُزِهَا الحَدَّ فِي العِصْيَانِ.","o":[]},{"a":12,"w":"انبَعَثَ","m":"نَهَضَ مُسْرِعًا؛ لِعَقْرِ النَّاقَةِ.","o":[]},{"a":12,"w":"أَشْقَاهَا","m":"أَكْثَرُهُمْ شَقَاوَةً، وَتَمَرُّدًا؛ وَهُوَ قُدَارُ بْنُ سَالِفٍ.","o":[]},{"a":13,"w":"نَاقَةَ اللَّهِ وَسُقْيَاهَا","m":"احْذَرُوا نَاقَةَ اللهِ أَنْ تَمَسُّوهَا بِسُوءٍ، وَأَنْ تَعْتَدُوا عَلَى سَقْيِهَا.","o":[[1,2],[2,2],[2,91],[2,103],[2,125],[5,4],[5,12],[6,3],[6,118],[7,57],[7,102],[9,30],[9,59],[9,66],[11,109],[12,24],[12,82],[12,96],[14,1],[16,0],[16,106],[18,32],[21,20],[21,21],[22,49],[22,54],[22,62],[22,67],[22,84],[27,7],[27,55],[29,2],[30,18],[30,48],[31,14],[31,32],[33,10],[33,71],[33,89],[33,106],[33,107],[33,119],[37,88],[39,68],[40,12],[40,34],[40,102],[42,23],[42,56],[45,7],[46,21],[46,47],[48,25],[48,27],[49,3],[57,20],[58,12],[59,12],[59,33],[59,46],[60,13],[61,5],[61,11],[62,14],[63,8],[64,8],[66,5],[71,1],[72,19],[73,26],[87,7],[98,2]]},{"a":14,"w":"فَعَقَرُوهَا","m":"فَنَحَرُوهَا.","o":[[11,76],[26,52]]},{"a":14,"w":"فَدَمْدَمَ","m":"فَأَطْبَقَ عَلَيْهِمْ العُقُوبَةَ.","o":[]},{"a":14,"w":"فَسَوَّاهَا","m":"عَمَّهُمْ بِالعُقُوبَةِ؛ فَلَمْ يُفْلِتْ مِنْهُمْ أَحَدٌ.","o":[]},{"a":15,"w":"عُقْبَاهَا","m":"عَاقِبَةَ مَا نَزَلَ بِهِمْ مِنَ العُقُوبَةِ.","o":[]}]}