{"no":101,"name":"القارعة","verses":11,"place":"مكية","count":7,"entries":[{"a":1,"w":"الْقَارِعَةُ","m":"القِيَامَةُ الَّتِي تَقْرَعُ القُلُوبَ بِأَهْوَالِهَا.","o":[]},{"a":4,"w":"الْمَبْثُوثِ","m":"المُنْتَشِرِ.","o":[]},{"a":5,"w":"كَالْعِهْنِ","m":"كَالصُّوفِ المَصْبُوغِ بِأَلْوَانٍ مُخْتَلِفَةٍ.","o":[[70,7]]},{"a":5,"w":"الْمَنفُوشِ","m":"الَّذِي مُزِّقَ، وَنُفِشَ، فَتَفَرَّقَتْ أَجْزَاؤُهُ.","o":[]},{"a":6,"w":"ثَقُلَتْ مَوَازِينُهُ","m":"رَجَحَتْ مَوَازِينُ حَسَنَاتِهِ.","o":[[23,69],[7,190]]},{"a":9,"w":"فَأُمُّهُ هَاوِيَةٌ","m":"مَاوَاهُ إِلَى جَهَنَّمَ يَهْوِي عَلَى رَاسِهِ.","o":[]},{"a":11,"w":"حَامِيَةٌ","m":"حَارَّةٌ قَدِ اشْتَدَّ إِيقَادُهَا.","o":[[88,4]]}]}