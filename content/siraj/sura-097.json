{"no":97,"name":"القدر","verses":5,"place":"مكية","count":5,"entries":[{"a":1,"w":"أَنزَلْنَاهُ","m":"أَنْزَلْنَا القَرْآنَ جُمْلَةً وَاحِدَةً مِنَ اللَّوْحِ المَحْفُوظِ إِلَى بَيْتِ العِزَّةِ فِي السَّمَاءِ الدُّنْيَا.","o":[]},{"a":1,"w":"لَيْلَةِ الْقَدْرِ","m":"لَيْلَةِ الشَّرَفِ، وَالعَظَمَةِ، وَكِتَابِ المَقَادِيرِ.","o":[[44,0]]},{"a":4,"w":"وَالرُّوحُ","m":"جِبْرِيلُ - عليه السلام -.","o":[[70,4]]},{"a":4,"w":"أَمْرٍ","m":"قَضَاءٍ قَدَّرَهُ اللهُ فِي تِلْكَ السَّنَةِ.","o":[[16,0],[24,75],[44,2],[57,20]]},{"a":5,"w":"سَلَامٌ","m":"أَمْنٌ، وَسَلَامَةٌ، وَتَسْلِيمٌ مِنَ المَلَائِكَةِ.","o":[[28,75]]}]}