{"no":76,"name":"الإنسان","verses":31,"place":"مدنية","count":42,"entries":[{"a":1,"w":"هَلْ أَتَى","m":"قَدْ مَضَى.","o":[[2,176],[50,36]]},{"a":1,"w":"حِينٌ","m":"زَمَنٌ طَوِيلٌ.","o":[[23,45],[26,79],[37,80],[38,5],[51,40],[52,46]]},{"a":2,"w":"أَمْشَاجٍ","m":"مُخْتَلِطَةٍ مِنْ مَاءِ الرَّجُلِ وَمَاءِ المَرْأَةِ.","o":[]},{"a":2,"w":"نَّبْتَلِيهِ","m":"نَخْتَبِرُهُ بِالأَوَامِرِ، وَالنَّوَاهِي.","o":[]},{"a":3,"w":"هَدَيْنَاهُ السَّبِيلَ","m":"بَيَّنَّا لَهُ طَرِيقَ الخَيْرِ، وَالشَّرِّ.","o":[[2,78],[2,108],[8,41],[9,67],[9,93],[16,6],[17,34],[28,20],[29,17],[33,3],[40,51],[42,53],[59,17],[60,3],[80,13]]},{"a":4,"w":"سَلَاسِلَا","m":"قُيُودًا مِنْ حَدِيدٍ تُشَدُّ بِهَا أَرْجُلُهُمْ.","o":[]},{"a":4,"w":"وَأَغْلَالًا","m":"تُغَلُّ وَتُجْمَعُ بِهَا أَيْدِيهِمْ إِلَى أَعْنَاقِهِمْ.","o":[]},{"a":4,"w":"وَسَعِيرًا","m":"نَارًا يُحْرَقُونَ بِهَا.","o":[]},{"a":5,"w":"كَاسٍ","m":"إِنَاءِ شُرْبِ الخَمْرِ، وَفِيهَا خَمْرٌ.","o":[]},{"a":5,"w":"مِزَاجُهَا كَافُورًا","m":"مَخْلُوطَةً بِأَحْسَنِ أَنْوَاعِ الطِّيبِ، وَهُوَ مَاءُ الكَافُورِ.","o":[]},{"a":6,"w":"يَشْرَبُ بِهَا","m":"يَشْرَبُونَ مُتَلَذِّذِينَ بِهَا.","o":[[83,20],[9,105],[12,28],[17,137],[20,10],[27,42],[30,26],[31,14],[48,25]]},{"a":6,"w":"يُفَجِّرُونَهَا","m":"يُجْرُونَهَا إِجْرَاءً سَهْلًا حَيْثُ شَاؤُوا.","o":[]},{"a":7,"w":"بِالنَّذْرِ","m":"بِمَا أَوْجَبُوا عَلَى أَنْفُسِهِمْ مِنَ الطَّاعَاتِ.","o":[[54,41]]},{"a":7,"w":"مُسْتَطِيرًا","m":"فَاشِيًا مُنْتَشِرًا عَلَى النَّاسِ.","o":[]},{"a":8,"w":"وَيَتِيمًا","m":"طِفْلًا مَاتَ وَالِدُهُ قَبْلَ بُلُوغِهِ، وَلَا مَالَ لَهُ.","o":[]},{"a":8,"w":"وَأَسِيرًا","m":"المَاخُوذَ فِي الحَرْبِ.","o":[]},{"a":10,"w":"عَبُوسًا","m":"تَكْلَحُ فِيهِ الوُجُوهُ لِهَوْلِهِ.","o":[]},{"a":10,"w":"قَمْطَرِيرًا","m":"شَدِيدَ العُبُوسِ.","o":[]},{"a":11,"w":"وَلَقَّاهُمْ","m":"أَعْطَاهُمْ.","o":[]},{"a":11,"w":"نَضْرَةً","m":"حُسْنًا وَنُورًا.","o":[[83,15]]},{"a":13,"w":"الْأَرَائِكِ","m":"الأَسِرَّةِ المُزَيَّنَةِ بِفَاخِرِ الثِّيَابِ، وَالسُّتُورِ.","o":[[18,44],[36,37],[83,14]]},{"a":13,"w":"زَمْهَرِيرًا","m":"شِدَّةَ بَرْدٍ.","o":[]},{"a":14,"w":"وَدَانِيَةً","m":"قَرِيبَةً أَشْجَارُهَا.","o":[]},{"a":14,"w":"وَذُلِّلَتْ قُطُوفُهَا","m":"سُهِّلَ لَهُمْ أَخْذُ ثِمَارِهَا.","o":[[69,28]]},{"a":15,"w":"قَوَارِيرَا","m":"مِنَ الزُّجَاجِ.","o":[]},{"a":16,"w":"قَدَّرُوهَا","m":"قَدَّرَهَا السُّقَاةُ عَلَى مِقْدَارِ مَا يَشْتَهِي الشَّارِبُونَ.","o":[]},{"a":17,"w":"كَاسًا","m":"إِنَاءً مَمْلُوءًا خَمْرًا.","o":[[52,16]]},{"a":18,"w":"تُسَمَّى سَلْسَبِيلًا","m":"سُمِّيَتْ بِذَلِكَ؛ لِسَلَاسَةِ شُرْبِهَا، وَسُهُولَةِ مَسَاغِهِ.","o":[]},{"a":19,"w":"وِلْدَانٌ مُّخَلَّدُونَ","m":"غِلْمَانٌ لِلْخِدْمَةِ دَائِمُونَ عَلَى حَالِهِمْ.","o":[[56,16]]},{"a":19,"w":"لُؤْلُؤًا","m":"كَاللُّؤْلُؤِ المُفَرَّقِ المُضِيءِ؛ لِحُسْنِهِمْ، وَصَفَاءِ أَلْوَانِهِمْ.","o":[[48,26]]},{"a":20,"w":"وَإِذَا رَأَيْتَ ثَمَّ","m":"وَإِذَا أَبْصَرْتَ أَيَّ مَكَانٍ فِي الجَنَّةِ.","o":[[11,61],[22,22],[26,23],[39,85],[67,6],[81,23]]},{"a":21,"w":"عَالِيَهُمْ","m":"يَعْلُوهُمْ.","o":[]},{"a":21,"w":"ثِيَابُ سُندُسٍ","m":"الحَرِيرُ الرَّقِيقُ الأَخْضَرُ؛ وَهَذَا بَاطِنُ الثِّيَابِ.","o":[[22,27],[18,42],[44,37]]},{"a":21,"w":"وَإِسْتَبْرَقٌ","m":"الحَرِيرُ الغَلِيظُ؛ وَهَذَا ظَاهِرُ الثُيَابِ.","o":[[18,43],[44,38]]},{"a":21,"w":"طَهُورًا","m":"لَا رِجْسَ فِيهِ، وَلَا دَنَسَ.","o":[]},{"a":22,"w":"سَعْيُكُم","m":"عَمَلُكُمُ الصَّالِحُ فِي الدُّنْيَا.","o":[]},{"a":24,"w":"لِحُكْمِ رَبِّكَ","m":"لِأَمْرِهِ القَدَرِيِّ فَتَقْبَلُهُ، وَلَأَمْرِهِ الشَّرْعِيِّ فَتَمْضِي عَلَيْهِ.","o":[[12,48],[16,115],[23,55],[40,70],[43,35],[43,37],[50,51],[52,23],[52,31],[52,45],[53,39],[56,63],[69,50],[74,25],[84,5],[87,0],[89,21],[99,5],[110,2]]},{"a":25,"w":"بُكْرَةً وَأَصِيلًا","m":"أَوَّلَ النَّهَارِ، وَآخِرَهُ.","o":[[25,7],[33,81],[48,10],[19,11],[54,48]]},{"a":26,"w":"وَسَبِّحْهُ","m":"صَلِّ لَهُ.","o":[]},{"a":28,"w":"وَشَدَدْنَا أَسْرَهُمْ","m":"أَحْكَمْنَا خَلْقَهُمْ.","o":[[38,27]]},{"a":29,"w":"تَذْكِرَةٌ","m":"عِظَةٌ.","o":[[56,61]]},{"a":29,"w":"سَبِيلًا","m":"طَرِيقًا 