{"no":69,"name":"الحاقة","verses":52,"place":"مكية","count":51,"entries":[{"a":1,"w":"الْحَاقَّةُ","m":"القِيَامَةُ الوَاقِعَةُ حَقًّا الَّتِي يَتَحَقَّقُ فِيهَا الوَعْدُ وَالوَعِيدُ.","o":[]},{"a":4,"w":"بِالْقَارِعَةِ","m":"بِالقِيَامَةِ الَّتِي تَقْرَعُ القُلُوبَ بِأَهْوَالِهَا.","o":[]},{"a":5,"w":"بِالطَّاغِيَةِ","m":"بِالصَّيْحَةِ الَّتِي جَاوَزَتِ الحَدَّ فِي شِدَّتِهَا.","o":[]},{"a":6,"w":"صَرْصَرٍ","m":"بَارِدَةٍ.","o":[]},{"a":6,"w":"عَاتِيَةٍ","m":"شَدِيدَةِ الهُبُوبِ.","o":[]},{"a":7,"w":"سَخَّرَهَا عَلَيْهِمْ","m":"سَلَّطَهَا عَلَيْهِمْ.","o":[[1,11],[9,103],[9,106],[18,26],[27,94],[28,64],[28,94],[34,44],[41,32],[41,37],[46,24],[48,6],[63,7],[66,14]]},{"a":7,"w":"حُسُومًا","m":"مُتُتُابِعَةً؛ لَا تَفْتُرُ، وَلَا تَنْقَطِعُ.","o":[]},{"a":7,"w":"صَرْعَى","m":"مَوْتَى.","o":[]},{"a":7,"w":"أَعْجَازُ نَخْلٍ","m":"أُصُولُ نَخْلٍ.","o":[[54,25]]},{"a":7,"w":"خَاوِيَةٍ","m":"خَرِبَةٍ مُتَآكِلَةِ الأَجْوَافِ.","o":[[2,190],[18,61],[22,76],[27,61]]},{"a":9,"w":"وَالْمُؤْتَفِكَاتُ","m":"أَهْلُ قُرَى قَوْمِ لُوطٍ الَّذِينَ انْقَلَبَتْ بِهِمْ دِيَارُهُمْ.","o":[[9,75]]},{"a":9,"w":"بِالْخَاطِئَةِ","m":"بِالفَعَلَاتِ ذَاتِ الخَطَإِ الجَسِيمِ.","o":[]},{"a":10,"w":"رَّابِيَةً","m":"بَالِغَةً فِي الشِّدَّةِ.","o":[]},{"a":11,"w":"طَغَى الْمَاءُ","m":"جَاوَزَ المَاءُ حَدَّهُ، وَارْتَفَعَ فَوْقَ كُلِّ شَيْءٍ.","o":[[53,16],[25,46],[54,12]]},{"a":11,"w":"الْجَارِيَةِ","m":"السَّفِينَةِ الَّتِي صَنَعَهَا نُوحٌ - عليه السلام -، تَجْرِي فِي المَاءِ.","o":[]},{"a":12,"w":"وَتَعِيَهَا","m":"تَحْفَظَهَا.","o":[]},{"a":13,"w":"الصُّورِ","m":"القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -.","o":[[6,45],[18,139],[20,86],[27,97],[36,30],[39,83],[50,25],[78,13]]},{"a":13,"w":"نَفْخَةٌ وَاحِدَةٌ","m":"النَّفْخَةُ الأُولَى الَّتِي يَكُونُ بِهَا هَلَاكُ العَالَمِ.","o":[[4,97],[11,146],[16,91],[21,78],[23,41],[36,28],[36,34],[38,18],[42,5],[43,38],[54,60]]},{"a":14,"w":"وَحُمِلَتِ","m":"رُفِعَتْ مِنْ أَمَاكِنِهَا.","o":[]},{"a":14,"w":"فَدُكَّتَا","m":"دُقَّتَا، وَكُس