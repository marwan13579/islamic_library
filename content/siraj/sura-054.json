{"no":54,"name":"القمر","verses":55,"place":"مكية","count":68,"entries":[{"a":1,"w":"وَانشَقَّ الْقَمَرُ","m":"انْفَلَقَ القَمَرُ فَلْقَتَيْنِ؛ مُعْجِزَةً لِلنَّبِيِّ - صلى الله عليه وسلم -، عِنْدَمَا سَأَلَهُ المُشِرْكُونَ آيَةً.","o":[]},{"a":2,"w":"مُّسْتَمِرٌّ","m":"بَاطِلٌ مُضْمَحِلٌّ، أَوْ قَوِيٌّ دَائِمٌ.","o":[[54,23]]},{"a":3,"w":"مُّسْتَقِرٌّ","m":"مُنْتَهٍ إِلَى غَايَةٍ يَسْتَقِرُّ عَلَيْهَا.","o":[[6,38],[54,49]]},{"a":4,"w":"مُزْدَجَرٌ","m":"كِفَايَةٌ لِرَدْعِهِمْ عَنْ كُفْرِهِمْ.","o":[]},{"a":6,"w":"شَيْءٍ نُّكُرٍ","m":"أَمْرٍ فَظِيعٍ مُنْكَرٍ؛ وَهُوَ مَوْقِفُ الحِسَابِ.","o":[[46,35],[60,28]]},{"a":7,"w":"خُشَّعًا","m":"ذَلِيلَةً مِنْ شِدَّةِ الهَوْلِ.","o":[]},{"a":7,"w":"الْأَجْدَاثِ","m":"القُبُورِ.","o":[[36,31],[70,32]]},{"a":8,"w":"مُّهْطِعِينَ","m":"مُسْرِعِينَ.","o":[[14,36],[70,28]]},{"a":9,"w":"وَازْدُجِرَ","m":"زُجِرَ، وَنُهِرَ عَنْ تَبْلِيغِ الدَّعْوَةِ.","o":[]},{"a":10,"w":"مَغْلُوبٌ","m":"ضَعِيفٌ عَنْ مُقَاوَمَتِهِمْ.","o":[]},{"a":11,"w":"مُّنْهَمِرٍ","m":"مُتَدَفِّقٍ.","o":[]},{"a":12,"w":"وَفَجَّرْنَا","m":"شَقَقْنَا.","o":[]},{"a":12,"w":"فَالْتَقَى الْمَاءُ","m":"الْتَقَى مَاءُ السَّمَاءِ وَالمَاءُ المُتَفَجِّرُ مِنَ الأَرْضِ.","o":[[25,46],[69,13]]},{"a":12,"w":"قُدِرَ","m":"قَدَّرَهُ اللهُ فِي الأَزَلِ؛ وَهُوَ إِهْلَاكُهُمْ بِالطُّوفَانِ.","o":[[20,23],[65,20],[77,17]]},{"a":13,"w":"عَلَى ذَاتِ أَلْوَاحٍ وَدُسُرٍ","m":"سَفِينَةٍ ذَاتِ أَلْوَاحٍ، وَمَسَامِيرَ شُدَّتْ بِهَا.","o":[[2,92],[3,73],[5,121],[7,171],[8,58],[10,1],[10,66],[10,67],[13,0],[18,9],[18,13],[18,61],[18,100],[20,10],[20,23],[20,61],[21,54],[21,55],[21,97],[22,17],[22,76],[23,50],[24,25],[27,36],[28,28],[33,39],[44,25],[47,41],[48,42],[48,48],[57,50],[68,26],[75,8],[104,9],[8,3],[23,38],[27,69],[51,5],[85,0],[86,9],[86,10],[89,6],[111,5]]},{"a":14,"w":"بِأَعْيُنِنَا","m":"بِمَرْأًى مِنَّا، وَحِفْظٍ، إِثْبَاتُ صِفَةِ العَيْنَيْنِ للهِ تَعَالَى؛ كَمَا يَلِيقُ بِجَلَالِهِ.","o":[[11,42],[23,18],[52,44]]},{"a":14,"w":"جَزَاءً","m":"أُغْرِقُوا انْتِصَارًا مِنَّا لِنُ