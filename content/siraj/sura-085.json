{"no":85,"name":"البروج","verses":22,"place":"مكية","count":14,"entries":[{"a":1,"w":"ذَاتِ الْبُرُوجِ","m":"ذَاتِ المَنَازِلِ الَّتِي تَمُرُّ بِهَا الشَّمْسُ، وَالقَمَرُ.","o":[[8,3],[23,38],[27,69],[51,5],[54,14],[86,9],[86,10],[89,6],[111,5]]},{"a":2,"w":"وَالْيَوْمِ الْمَوْعُودِ","m":"يَوْمُ القِيَامَةِ.","o":[]},{"a":3,"w":"وَشَاهِدٍ وَمَشْهُودٍ","m":"أَقْسَمَ اللهُ بِكُلِّ شَاهِدٍ يَشْهَدُ، وَبِكُلِّ مَنْ يُشْهَدُ عَلَيْهِ.","o":[]},{"a":4,"w":"قُتِلَ","m":"لُعِنَ، وَعُذِّبَ، وَهَلَكَ.","o":[[51,8],[80,9]]},{"a":4,"w":"أَصْحَابُ الْأُخْدُودِ","m":"الَّذِينَ شَقُّوا فِي الأَرْضِ شَقًّا عَظِيمًا؛ لِإِحْرَاقِ المُؤْمِنِينَ.","o":[[7,37],[15,51],[15,53],[26,58],[56,77]]},{"a":5,"w":"الْوَقُودِ","m":"مَا تُشْعَلُ وَتُوقَدُ بِهِ النَّارُ.","o":[]},{"a":7,"w":"شُهُودٌ","m":"حُضُورٌ.","o":[]},{"a":10,"w":"فَتَنُوا","m":"حَرَّقُوا بِالنَّارِ.","o":[[16,101]]},{"a":10,"w":"عَذَابُ الْحَرِيقِ","m":"العَذَابُ المُحْرِقُ.","o":[[34,5],[46,28],[52,21],[89,11]]},{"a":12,"w":"بَطْشَ","m":"انْتِقَامَ.","o":[]},{"a":13,"w":"يُبْدِئُ","m":"يَخْلُقُ الخَلْقَ ابْتِدَاءً.","o":[]},{"a":13,"w":"وَيُعِيدُ","m":"يُحْيِيهِمْ بَعْدَ مَوْتِهِمْ.","o":[]},{"a":14,"w":"الْوَدُودُ","m":"المُحِبُّ لِأَوْلِيَائِهِ، المَحْبُوبُ لَهُمْ.","o":[]},{"a":15,"w":"الْمَجِيدُ","m":"العَظِيمُ.","o":[[50,0]]}]}