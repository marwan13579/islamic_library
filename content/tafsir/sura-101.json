{"no":101,"name":"القَارعَة","nameEn":"Al-Qāri‘ah","ayat":[{"j":30,"p":600,"n":1,"t":"ٱلۡقَارِعَةُ","f":"[1] الساعة التي تقرع قلوب الناس بأهوالها."},{"j":30,"p":600,"n":2,"t":"مَا ٱلۡقَارِعَةُ","f":"[2] أيُّ شيء هذه القارعة؟"},{"j":30,"p":600,"n":3,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","f":"[3] وأيُّ شيء أعلمك بها؟"},{"j":30,"p":600,"n":4,"t":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","f":"[4] في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار."},{"j":30,"p":600,"n":5,"t":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","f":"[5] وتكون الجبال كالصوف المتعدِّدِ الألوان الذي يُنْفَش باليد، فيصير هباء ويزول."},{"j":30,"p":600,"n":6,"t":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","f":"[6] فأما من رجحت موازين حسناته"},{"j":30,"p":600,"n":7,"t":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","f":"[7]  فهو في حياة مرضية في الجنة."},{"j":30,"p":600,"n":8,"t":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ﰇ","f":"[8] وأما من خفت موازين حسناته"},{"j":30,"p":600,"n":9,"t":"فَأُمُّهُۥ هَاوِيَةٞ","f":"[9]  ورجحت موازين سيئاته، فمأواه جهنم."},{"j":30,"p":600,"n":10,"t":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","f":"[10] وما أدراك -أيها الرسول- ما هذه الهاوية؟"},{"j":30,"p":600,"n":11,"t":"نَارٌ حَامِيَةُۢ","f":"[11] إنها نار قد حَمِيت من الوقود عليها."}]}